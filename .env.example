# SPECTRA | AI Audio Forensics & Fingerprint Analysis Laboratory
# Copy this file to .env to customize local settings. No paid APIs or secrets required.

SPECTRA_ENV=development
SPECTRA_HOST=127.0.0.1
SPECTRA_PORT=8000
SPECTRA_FRONTEND_URL=http://localhost:3000
SPECTRA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage & Database
SPECTRA_STORAGE_DIR=./storage
SPECTRA_MODELS_DIR=./models
SPECTRA_DB_URL=sqlite:///./storage/spectra.db

# Ingestion & Security Limits
SPECTRA_MAX_UPLOAD_MB=100
SPECTRA_MAX_DURATION_SEC=600
SPECTRA_RETENTION_HOURS=168
SPECTRA_MAX_WORKERS=2

# Detector Configuration
SPECTRA_FAKEPRINT_MODEL_PATH=./models/fakeprint/ai_music_detector.onnx
SPECTRA_FAKEPRINT_CONFIG_PATH=./models/fakeprint/config.yaml
SPECTRA_ENABLE_SONICS=true
SPECTRA_SONICS_DEFAULT_REPO=awsaf49/sonics-spectttra-gamma-5s
SPECTRA_SONICS_AUTO_DOWNLOAD=false

# Optional Local ComfyUI Integration
SPECTRA_COMFYUI_ENABLED=true
SPECTRA_COMFYUI_URL=http://127.0.0.1:8188
SPECTRA_COMFYUI_INSTALL_PATH=D:\ComfyUI\Nyx\ComfyUI
SPECTRA_COMFYUI_SHARED_DIR=C:\Users\user\AppData\Local\Comfy-Desktop\ComfyUI-Shared
